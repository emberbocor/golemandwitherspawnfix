{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Iron golems and withers spawn even when grass, snow, carpets or other small blocks sit in the empty spots of their build. Only needed on the server.",
  "authors": [
    "emberbocor"
  ],
  "contact": {
    "homepage": "https://github.com/emberbocor/golemandwitherspawnfix",
    "sources": "https://github.com/emberbocor/golemandwitherspawnfix",
    "issues": "https://github.com/emberbocor/golemandwitherspawnfix/issues"
  },
  "license": "${mod_license}",
  "environment": "*",
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": "${fabric_loader_version_range}",
    "fabric-api": "${fabric_api_version_range}",
    "minecraft": "${fabric_minecraft_version_range}",
    "java": ">=17"
  }
}
